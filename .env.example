# Development and production must use separate values and separate MongoDB databases.
APP_ENV=dev
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/witchmap_dev
MONGODB_DB=witchmap_dev
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=witchmap-dev-media
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Production examples:
# APP_ENV=prd
# BETTER_AUTH_URL=https://api.your-domain.example
# MONGODB_DB=witchmap_prd
# CLOUDFLARE_R2_BUCKET=witchmap-prd-media
